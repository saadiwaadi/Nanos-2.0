generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── PRODUCTS ───────────────────────────────────────────

model Product {
  id          String  @id
  sku         String  @unique
  name        String
  category    String  // "crocs" | "trousers"
  tag         String? // "NEW" | "SALE" | "BESTSELLER"
  price       Int     // PKR integer
  oldPrice    Int?
  description String
  rating      Float   @default(0)
  reviews     Int     @default(0)
  hero        String  // main image URL
  isSale      Boolean @default(false)
  ignoreStock Boolean @default(false)

  // Display data — JSON strings
  colors  String @default("[]") // [{name, hex}]
  sizes   String @default("[]") // ["UK 6","UK 7",...]
  gallery String @default("[]") // [url, url, url]

  // Relations
  stockLevels   StockLevel[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  productColors ProductColor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductColor {
  id         String   @id @default(cuid())
  productId  String
  name       String
  hex        String
  imagesJson String   @default("[]")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
}

model StockLevel {
  id          String  @id @default(cuid())
  productId   String
  color       String
  size        String
  quantity    Int     @default(0)
  ignoreStock Boolean @default(false)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, color, size])
}

// ─── USERS ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("customer") // "customer" | "admin"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart     Cart?
  orders   Order[]
  wishlist WishlistItem[]
}

// ─── CART ───────────────────────────────────────────────

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  color     String
  size      String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, color, size])
}

// ─── WISHLIST ───────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

// ─── ORDERS ─────────────────────────────────────────────

model Order {
  id             String   @id @default(cuid())
  userId         String?
  guestEmail     String?
  guestName      String?
  customerName   String?
  customerEmail  String?
  subtotal       Int      @default(0)
  discount       Int      @default(0)
  shipping       Int      @default(0)
  total          Int      @default(0)
  shippingInfo   String   @default("{}") // JSON string
  notes          String?
  payment        String   @default("cod") // "cod" | "card" | "easypaisa"

  // Lifecycle & booking pipeline
  status               String    @default("placed")       // lifecycle
  courierBookingStatus String    @default("not_booked") @map("courierStatus")  // booking pipeline
  courierStatusRaw     String?                            // last raw PostEx status
  courierSyncedAt      DateTime?
  trackingNumber       String?
  postexTrackingNumber String?   @map("postexTracking")
  adminApproved        Boolean   @default(false)

  bookingAttempts      Int       @default(0)
  bookingLockedAt      DateTime?
  bookingError         String?
  bookingAmbiguous     Boolean   @default(false)           // timeout: may exist on PostEx
  stockReserved        Boolean   @default(false)
  isTest               Boolean   @default(false)
  version              Int       @default(0)

  user        User?              @relation(fields: [userId], references: [id])
  items       OrderItem[]
  bookingLogs PostexBookingLog[]
  events      OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, courierBookingStatus])
  @@index([trackingNumber])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  sku          String
  name         String  // denormalized for display
  color        String
  size         String
  quantity     Int
  unitPrice    Int     // price at time of order
  stockTracked Boolean @default(false)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // status_change | edited | booking | courier_sync | stock
  fromValue String?
  toValue   String?
  actor     String   // admin email, "system:batch", "system:sync"
  reason    String?
  metadata  Json?    @map("meta")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model PostexBookingLog {
  id              String   @id @default(cuid())
  orderId         String
  attemptedAt     DateTime @default(now()) @map("createdAt")
  requestPayload  String   @default("{}") @map("request")
  responsePayload String   @default("{}") @map("response")
  success         Boolean
  errorMessage    String?  @map("error")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("BookingLog")
}

model PostexAutoBookCity {
  id        String   @id @default(cuid())
  cityName  String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── SIZE CHARTS ────────────────────────────────────────

model SizeChart {
  category String @id // "crocs" | "trousers"
  rows     String @default("[]") // JSON: [{size: "UK 6"}, ...]
  updatedAt DateTime @updatedAt
}

// ─── SETTINGS ───────────────────────────────────────────

model CategorySetting {
  category          String @id
  lowStockThreshold Int    @default(20)
}

model HomeSetting {
  key       String   @id
  value     String   @default("{}") // JSON string value
  updatedAt DateTime @updatedAt
}

