generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── PRODUCTS ───────────────────────────────────────────

model Product {
  id          String  @id
  sku         String  @unique
  name        String
  category    String  // "crocs" | "trousers"
  tag         String? // "NEW" | "SALE" | "BESTSELLER"
  price       Int     // PKR integer
  oldPrice    Int?
  description String
  rating      Float   @default(0)
  reviews     Int     @default(0)
  hero        String  // main image URL
  isSale      Boolean @default(false)

  // Display data — JSON strings, no separate tables
  colors  String @default("[]") // [{name, hex}]
  sizes   String @default("[]") // ["UK 6","UK 7",...]
  gallery String @default("[]") // [url, url, url]

  // Relations
  stockLevels   StockLevel[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockLevel {
  id        String  @id @default(cuid())
  productId String
  color     String
  size      String
  quantity  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, color, size])
}

// ─── USERS ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("customer") // "customer" | "admin"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart     Cart?
  orders   Order[]
  wishlist WishlistItem[]
}

// ─── CART ───────────────────────────────────────────────

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  color     String
  size      String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, color, size])
}

// ─── WISHLIST ───────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

// ─── ORDERS ─────────────────────────────────────────────

model Order {
  id             String   @id @default(cuid())
  userId         String?
  guestEmail     String?
  guestName      String?
  subtotal       Int      @default(0)
  discount       Int      @default(0)
  shipping       Int      @default(0)
  total          Int      @default(0)
  shippingInfo   String   @default("{}") // JSON: {name, phone, email, address, city, postal}
  payment        String   @default("cod") // "cod" | "card" | "easypaisa"
  status         String   @default("processing") // "processing" | "shipped" | "delivered" | "cancelled"

  // PostEx fields (populated later)
  courierStatus  String?
  postexTracking String?
  adminApproved  Boolean  @default(false)

  user      User?         @relation(fields: [userId], references: [id])
  items     OrderItem[]
  logs      BookingLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  sku       String
  name      String // denormalized for display
  color     String
  size      String
  quantity  Int
  unitPrice Int    // price at time of order
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model BookingLog {
  id        String  @id @default(cuid())
  orderId   String
  request   String  @default("{}") // JSON
  response  String  @default("{}") // JSON
  success   Boolean
  error     String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ─── SIZE CHARTS ────────────────────────────────────────

model SizeChart {
  category String @id // "crocs" | "trousers"
  rows     String @default("[]") // JSON: [{size: "UK 6"}, ...]
  updatedAt DateTime @updatedAt
}

// ─── SETTINGS ───────────────────────────────────────────

model CategorySetting {
  category          String @id
  lowStockThreshold Int    @default(20)
}
